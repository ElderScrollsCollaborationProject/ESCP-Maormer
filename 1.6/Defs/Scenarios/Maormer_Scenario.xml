<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ScenarioDef>
        <defName>ESCP_Scenario_Maormer</defName>
        <label>Pyandonean Exiles</label>
        <description>A crew of Sea Elves who have left Pyandonea, or been left behind by it. The ship is gone, the grudge is not, and the land will have to do for now.</description>
        <scenario>
            <summary>A crew of Sea Elves who have left Pyandonea, or been left behind by it. The ship is gone, the grudge is not, and the land will have to do for now.</summary>
            <playerFaction>
                <def>PlayerFaction</def>
                <factionDef>ESCP_Faction_Maormer_Player</factionDef>
            </playerFaction>
            <surfaceLayer>
                <def>SurfaceLayerFixed</def>
                <tag>Surface</tag>
                <layer>Surface</layer>
                <settingsDef>Surface</settingsDef>
                <hide>true</hide>
                <connections>
                    <Orbit MayRequire="Ludeon.RimWorld.Odyssey">
                        <zoomMode>ZoomOut</zoomMode>
                    </Orbit>
                </connections>
            </surfaceLayer>
            <parts>
                <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
                    <def>ConfigPage_ConfigureStartingPawns</def>
                    <pawnCount>4</pawnCount>
                    <pawnChoiceCount>8</pawnChoiceCount>
                </li>
                <li Class="ScenPart_PlayerPawnsArriveMethod">
                    <def>PlayerPawnsArriveMethod</def>
                    <method>Standing</method>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Silver</thingDef>
                    <count>400</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>Pemmican</thingDef>
                    <count>200</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>MedicineHerbal</thingDef>
                    <count>20</count>
                </li>
                <li Class="ScenPart_StartingThing_Defined">
                    <def>StartingThing_Defined</def>
                    <thingDef>WoodLog</thingDef>
                    <count>300</count>
                </li>
            </parts>
        </scenario>
    </ScenarioDef>

</Defs>
